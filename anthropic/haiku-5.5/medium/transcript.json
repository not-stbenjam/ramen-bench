        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Vegan Ramen</title>\n<style>\n  :root { color-scheme: dark; }\n  html, body { margin: 0; height: 100%; background: #060403; overflow: hidden; }\n  canvas {\n    position: fixed; inset: 0;\n    width: 100%; height: 100%;\n    display: block;\n    touch-action: none;\n    cursor: crosshair;\n  }\n  .vignette {\n    position: fixed; inset: 0;\n    pointer-events: none;\n    background: radial-gradient(ellipse 75% 70% at 50% 56%, transparent 45%, rgba(0, 0, 0, 0.7) 100%);\n  }\n</style>\n</head>\n<body>\n<canvas id=\"scene\" role=\"img\" aria-label=\"A steaming bowl of vegan ramen\"></canvas>\n<div class=\"vignette\"></div>\n\n<script>\n(() => {\n  'use strict';\n\n  const canvas = document.getElementById('scene');\n  const ctx = canvas.getContext('2d');\n  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');\n  const TAU = Math.PI * 2;\n\n  // Layout (CSS pixels, except where noted). World units: bowl centre is (0, 0).\n  let W = 0, H = 0, DPR = 1, S = 1, OX = 0, OY = 0;\n\n  const pointer = { px: 0, py: 0, wx: 0, wy: 0, active: false, moved: 0 };\n  const view = { x: 0, y: 0, tx: 0, ty: 0 };   // bowl parallax towards the pointer\n  const ripples = [];\n  const BROTH = { x: 0, y: 4, rx: 204, ry: 52 };\n  let light = 0;          // warm light shift towards the pointer (screen px)\n  let time = 0, last = 0, rafId = 0, rippleCooldown = 0;\n\n  // Seeded RNG so the composition is identical on every load.\n  let seed = 20260;\n  const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };\n  const rand = (a, b) => a + rnd() * (b - a);\n  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));\n\n  // ---- Composition ---------------------------------------------------------\n\n  const NOODLES = Array.from({ length: 58 }, () => ({\n    x: rand(-175, 175), y: 4 + rand(-42, 42),\n    a: rand(-0.6, 0.6), len: rand(120, 260),\n    amp: rand(3, 8), freq: rand(2, 4.5), ph: rand(0, TAU),\n    w: rand(2.6, 4.4), sh: rnd()\n  }));\n\n  const SESAME = Array.from({ length: 80 }, () => ({\n    x: rand(-190, 190), y: 4 + rand(-46, 46), r: rand(0.8, 1.6)\n  }));\n\n  const SCALLIONS = Array.from({ length: 22 }, () => ({\n    x: rand(-120, 120), y: rand(-32, 22), r: rand(3, 5)\n  }));\n\n  const CORN = Array.from({ length: 14 }, () => ({\n    x: rand(110, 165), y: rand(-22, 8), r: rand(3.2, 4.4)\n  }));\n\n  const CHILI = Array.from({ length: 9 }, () => ({\n    x: rand(-170, 170), y: rand(-25, 25), r: rand(2.5, 4)\n  }));\n\n  const TOFU = [\n    { x: 40, y: -8, w: 56, h: 42, r: 0.25 },\n    { x: -20, y: 22, w: 50, h: 38, r: -0.2 },\n    { x: 108, y: 16, w: 46, h: 36, r: 0.5 }\n  ];\n\n  const SHIITAKE = [\n    { x: -88, y: -2, rx: 40, ry: 27, r: 0.35 },\n    { x: 62, y: 30, rx: 30, ry: 21, r: -0.3 }\n  ];\n\n  const NORI = { x: -132, y: -12, r: -0.3 };\n  const BOK = { x: 150, y: 16, r: -0.9, s: 0.5 };\n\n  // Chopsticks resting across the rim\n  const STICKS = [\n    { x1: 300, y1: -210, x2: -26, y2: -58, w: 9, c: '#c58d55' },\n    { x1: 286, y1: -180, x2: -10, y2: -50, w: 8, c: '#a86f3e' }\n  ];\n\n  // Steam\n  const sprite = document.createElement('canvas');\n  sprite.width = sprite.height = 128;\n  {\n    const sc = sprite.getContext('2d');\n    const g = sc.createRadialGradient(64, 64, 0, 64, 64, 64);\n    g.addColorStop(0, 'rgba(255, 236, 210, 1)');\n    g.addColorStop(0.4, 'rgba(255, 220, 180, 0.45)');\n    g.addColorStop(1, 'rgba(255, 200, 150, 0)');\n    sc.fillStyle = g;\n    sc.fillRect(0, 0, 128, 128);\n  }\n\n  function spawnSteam(initial) {\n    const max = rand(4.5, 7.5);\n    return {\n      age: initial ? rand(0, max) : 0, max,\n      bx: rand(-120, 120), y0: rand(-46, -30),\n      sp: rand(14, 24), amp: rand(10, 22), ph: rand(0, TAU),\n      size: rand(60, 110),\n      ox: 0, oy: 0, vx: 0, vy: 0, x: 0, y: 0\n    };\n  }\n  const steam = Array.from({ length: 70 }, () => spawnSteam(true));\n\n  // Ambient dust motes, in normalised screen space\n  const MOTES = Array.from({ length: 46 }, () => ({\n    x: rnd(), y: rnd(), z: rand(0.25, 1), ph: rand(0, TAU)\n  }));\n\n  // ---- Helpers -------------------------------------------------------------\n\n  function rr(x, y, w, h, r) {\n    ctx.beginPath();\n    ctx.moveTo(x + r, y);\n    ctx.arcTo(x + w, y, x + w, y + h, r);\n    ctx.arcTo(x + w, y + h, x, y + h, r);\n    ctx.arcTo(x, y + h, x, y, r);\n    ctx.arcTo(x, y, x + w, y, r);\n    ctx.closePath();\n  }\n\n  function inBroth(x, y) {\n    const u = (x - BROTH.x) / BROTH.rx, v = (y - BROTH.y) / BROTH.ry;\n    return u * u + v * v < 0.85;\n  }\n\n  function addRipple(x, y, strength) {\n    ripples.push({ x, y, age: 0, life: 1.6 + 0.4 * strength });\n  }\n\n  // ---- Drawing: toppings ---------------------------------------------------\n\n  function drawTofu(t) {\n    ctx.save();\n    ctx.translate(t.x, t.y);\n    ctx.rotate(t.r);\n    ctx.fillStyle = 'rgba(0, 0, 0, 0.35)';\n    rr(-t.w / 2 + 3, -t.h / 2 + 5, t.w, t.h, 6);\n    ctx.fill();\n    const g = ctx.createLinearGradient(0, -t.h / 2, 0, t.h / 2);\n    g.addColorStop(0, '#fff1cf');\n    g.addColorStop(1, '#d9a158');\n    ctx.fillStyle = g;\n    rr(-t.w / 2, -t.h / 2, t.w, t.h, 6);\n    ctx.fill();\n    ctx.strokeStyle = 'rgba(150, 80, 25, 0.55)';\n    ctx.lineWidth = 2;\n    ctx.stroke();\n    ctx.strokeStyle = 'rgba(120, 60, 20, 0.35)';\n    ctx.lineWidth = 1.4;\n    for (let i = -1; i <= 1; i++) {\n      ctx.beginPath();\n      ctx.moveTo(-t.w * 0.3, i * t.h * 0.25 - 4);\n      ctx.lineTo(t.w * 0.3, i * t.h * 0.25 + 4);\n      ctx.stroke();\n    }\n    ctx.restore();\n  }\n\n  function drawShiitake(m) {\n    ctx.save();\n    ctx.translate(m.x, m.y);\n    ctx.rotate(m.r);\n    ctx.fillStyle = 'rgba(0, 0, 0, 0.3)';\n    ctx.beginPath();\n    ctx.ellipse(2, 5, m.rx, m.ry, 0, 0, TAU);\n    ctx.fill();\n    const g = ctx.createRadialGradient(-m.rx * 0.25, -m.ry * 0.3, 2, 0, 0, m.rx);\n    g.addColorStop(0, '#9b6a40');\n    g.addColorStop(0.6, '#5a3519');\n    g.addColorStop(1, '#2a1709');\n    ctx.fillStyle = g;\n    ctx.beginPath();\n    ctx.ellipse(0, 0, m.rx, m.ry, 0, 0, TAU);\n    ctx.fill();\n    ctx.strokeStyle = 'rgba(230, 190, 130, 0.22)';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    for (let i = 0; i < 14; i++) {\n      const a = (i / 14) * TAU;\n      ctx.moveTo(Math.cos(a) * m.rx * 0.35, Math.sin(a) * m.ry * 0.35);\n      ctx.lineTo(Math.cos(a) * m.rx * 0.92, Math.sin(a) * m.ry * 0.92);\n    }\n    ctx.stroke();\n    ctx.fillStyle = 'rgba(255, 225, 180, 0.25)';\n    ctx.beginPath();\n    ctx.ellipse(-m.rx * 0.35, -m.ry * 0.4, m.rx * 0.22, m.ry * 0.12, -0.3, 0, TAU);\n    ctx.fill();\n    ctx.restore();\n  }\n\n  function drawNori(n) {\n    ctx.save();\n    ctx.translate(n.x, n.y);\n    ctx.rotate(n.r);\n    const g = ctx.createLinearGradient(-34, -24, 34, 24);\n    g.addColorStop(0, '#1c3a24');\n    g.addColorStop(0.5, '#0b1a10');\n    g.addColorStop(1, '#050c07');\n    ctx.fillStyle = g;\n    rr(-36, -26, 72, 52, 3);\n    ctx.fill();\n    ctx.strokeStyle = 'rgba(160, 230, 180, 0.18)';\n    ctx.lineWidth = 1;\n    for (let i = 1; i < 6; i++) {\n      const y = -26 + i * 8.67;\n      ctx.beginPath();\n      ctx.moveTo(-36, y);\n      ctx.lineTo(36, y + 1.5);\n      ctx.stroke();\n    }\n    ctx.restore();\n  }\n\n  function drawBok(b) {\n    ctx.save();\n    ctx.translate(b.x, b.y);\n    ctx.rotate(b.r);\n    ctx.scale(b.s, b.s);\n    const g = ctx.createLinearGradient(0, 0, 0, -115);\n    g.addColorStop(0, '#2f6e2a');\n    g.addColorStop(1, '#8fd06a');\n    ctx.fillStyle = g;\n    ctx.beginPath();\n    ctx.moveTo(0, 0);\n    ctx.bezierCurveTo(-42, -26, -40, -92, 0, -115);\n    ctx.bezierCurveTo(40, -92, 42, -26, 0, 0);\n    ctx.fill();\n    ctx.strokeStyle = 'rgba(230, 250, 200, 0.6)';\n    ctx.lineWidth = 3;\n    ctx.beginPath();\n    ctx.moveTo(0, -4);\n    ctx.quadraticCurveTo(-4, -60, 0, -104);\n    ctx.stroke();\n    ctx.restore();\n  }\n\n  function drawScallion(s) {\n    ctx.fillStyle = '#6fae4a';\n    ctx.beginPath();\n    ctx.arc(s.x, s.y, s.r, 0, TAU);\n    ctx.fill();\n    ctx.fillStyle = '#eef8dc';\n    ctx.beginPath();\n    ctx.arc(s.x, s.y, s.r * 0.55, 0, TAU);\n    ctx.fill();\n    ctx.strokeStyle = 'rgba(20, 50, 20, 0.5)';\n    ctx.lineWidth = 0.8;\n    ctx.beginPath();\n    ctx.arc(s.x, s.y, s.r, 0, TAU);\n    ctx.stroke();\n  }\n\n  function drawCorn(c) {\n    ctx.fillStyle = '#ffd34d';\n    ctx.beginPath();\n    ctx.arc(c.x, c.y, c.r, 0, TAU);\n    ctx.fill();\n    ctx.fillStyle = 'rgba(255, 255, 220, 0.45)';\n    ctx.beginPath();\n    ctx.arc(c.x - c.r * 0.3, c.y - c.r * 0.3, c.r * 0.3, 0, TAU);\n    ctx.fill();\n  }\n\n  function drawChili(c) {\n    const g = ctx.createRadialGradient(c.x - c.r * 0.3, c.y - c.r * 0.3, 0.5, c.x, c.y, c.r);\n    g.addColorStop(0, '#ffb27a');\n    g.addColorStop(0.5, '#e2402a');\n    g.addColorStop(1, 'rgba(120, 10, 10, 0.8)');\n    ctx.fillStyle = g;\n    ctx.beginPath();\n    ctx.arc(c.x, c.y, c.r, 0, TAU);\n    ctx.fill();\n  }\n\n  // ---- Drawing: bowl, broth, chopsticks, steam -----------------------------\n\n  function drawBowl() {\n    // Contact shadow on the table\n    ctx.save();\n    ctx.translate(0, 214);\n    ctx.scale(1, 0.16);\n    const sh = ctx.createRadialGradient(0, 0, 20, 0, 0, 310);\n    sh.addColorStop(0, 'rgba(0, 0, 0, 0.85)');\n    sh.addColorStop(1, 'rgba(0, 0, 0, 0)');\n    ctx.fillStyle = sh;\n    ctx.beginPath();\n    ctx.arc(0, 0, 310, 0, TAU);\n    ctx.fill();\n    ctx.restore();\n\n    // Body: matte glazed ceramic\n    const body = ctx.createLinearGradient(-230, 0, 230, 0);\n    body.addColorStop(0, '#0b1212');\n    body.addColorStop(0.3, '#284540');\n    body.addColorStop(0.45, '#33554e');\n    body.addColorStop(0.75, '#14201f');\n    body.addColorStop(1, '#070b0b');\n    ctx.fillStyle = body;\n    ctx.beginPath();\n    ctx.moveTo(-230, 0);\n    ctx.bezierCurveTo(-232, 150, -120, 215, 0, 215);\n    ctx.bezierCurveTo(120, 215, 232, 150, 230, 0);\n    ctx.ellipse(0, 0, 230, 70, 0, 0, Math.PI, false);\n    ctx.closePath();\n    ctx.fill();\n\n    // Soft specular on the left flank\n    ctx.strokeStyle = 'rgba(255, 255, 255, 0.07)';\n    ctx.lineWidth = 9;\n    ctx.lineCap = 'round';\n    ctx.beginPath();\n    ctx.moveTo(-205, 20);\n    ctx.bezierCurveTo(-210, 120, -120, 180, -40, 190);\n    ctx.stroke();\n\n    // Rim and inner wall\n    ctx.beginPath();\n    ctx.ellipse(0, 0, 230, 70, 0, 0, TAU);\n    ctx.fillStyle = '#1d2c2a';\n    ctx.fill();\n    const inner = ctx.createRadialGradient(0, 10, 10, 0, 0, 220);\n    inner.addColorStop(0, '#3b1d0c');\n    inner.addColorStop(1, '#120803');\n    ctx.beginPath();\n    ctx.ellipse(0, 0, 216, 62, 0, 0, TAU);\n    ctx.fillStyle = inner;\n    ctx.fill();\n\n    // Catch-light along the top of the rim\n    ctx.beginPath();\n    ctx.ellipse(0, 0, 227, 67, 0, Math.PI * 1.02, Math.PI * 1.98);\n    ctx.strokeStyle = 'rgba(255, 255, 255, 0.14)';\n    ctx.lineWidth = 2;\n    ctx.stroke();\n  }\n\n  function drawBroth() {\n    ctx.save();\n    ctx.beginPath();\n    ctx.ellipse(BROTH.x, BROTH.y, BROTH.rx, BROTH.ry, 0, 0, TAU);\n    ctx.clip();\n\n    // Broth base: warm amber, darker towards the walls\n    const base = ctx.createRadialGradient(-30, -10, 10, 0, 4, 220);\n    base.addColorStop(0, '#ffc766');\n    base.addColorStop(0.45, '#c9782a');\n    base.addColorStop(0.85, '#6b3412');\n    base.addColorStop(1, '#3a1c09');\n    ctx.fillStyle = base;\n    ctx.fillRect(-260, -120, 520, 240);\n\n    // Noodles, gently undulating\n    ctx.lineJoin = 'round';\n    ctx.lineCap = 'round';\n    for (const n of NOODLES) {\n      ctx.beginPath();\n      for (let i = 0; i <= 14; i++) {\n        const s = i / 14, t = s - 0.5;\n        const px = n.x + Math.cos(n.a) * n.len * t;\n        const py = n.y + Math.sin(n.a) * n.len * t +\n          Math.sin(s * n.freq * TAU * 0.5 + n.ph + time * 0.7) * n.amp;\n        if (i === 0) ctx.moveTo(px, py);\n        else ctx.lineTo(px, py);\n      }\n      ctx.lineWidth = n.w + 1.4;\n      ctx.strokeStyle = 'rgba(120, 58, 14, 0.45)';\n      ctx.stroke();\n      ctx.lineWidth = n.w;\n      ctx.strokeStyle = `hsl(${42 + n.sh * 6}, 92%, ${60 + n.sh * 16}%)`;\n      ctx.stroke();\n    }\n\n    // Sesame\n    ctx.fillStyle = 'rgba(250, 236, 205, 0.85)';\n    for (const s of SESAME) {\n      ctx.beginPath();\n      ctx.arc(s.x, s.y, s.r, 0, TAU);\n      ctx.fill();\n    }\n\n    // Toppings\n    for (const m of SHIITAKE) drawShiitake(m);\n    for (const t of TOFU) drawTofu(t);\n    for (const s of SCALLIONS) drawScallion(s);\n    for (const c of CORN) drawCorn(c);\n    for (const c of CHILI) drawChili(c);\n    drawNori(NORI);\n    drawBok(BOK);\n\n    // Slow specular sweep across the surface\n    const sweep = Math.sin(time * 0.25) * 110;\n    const sg = ctx.createRadialGradient(sweep, -6, 2, sweep, -6, 70);\n    sg.addColorStop(0, 'rgba(255, 248, 225, 0.22)');\n    sg.addColorStop(1, 'rgba(255, 248, 225, 0)');\n    ctx.fillStyle = sg;\n    ctx.fillRect(-260, -120, 520, 240);\n\n    // Ripples from pointer movement and clicks\n    for (const r of ripples) {\n      const k = r.age / r.life;\n      const rad = 6 + r.age * 40;\n      ctx.beginPath();\n      ctx.ellipse(r.x, r.y, rad, rad * 0.27, 0, 0, TAU);\n      ctx.strokeStyle = `rgba(255, 240, 205, ${((1 - k) * 0.5).toFixed(3)})`;\n      ctx.lineWidth = 1.3;\n      ctx.stroke();\n    }\n    ctx.restore();\n  }\n\n  function drawChopsticks() {\n    const sway = Math.sin(time * 0.6) * 3;\n    ctx.lineCap = 'round';\n    STICKS.forEach((s, i) => {\n      const dir = i === 0 ? sway : -sway;\n      const x1 = s.x1, y1 = s.y1 + dir, x2 = s.x2, y2 = s.y2 + dir * 0.5;\n      ctx.strokeStyle = 'rgba(0, 0, 0, 0.45)';\n      ctx.lineWidth = s.w + 3;\n      ctx.beginPath();\n      ctx.moveTo(x1 + 3, y1 + 6);\n      ctx.lineTo(x2 + 3, y2 + 6);\n      ctx.stroke();\n      ctx.strokeStyle = s.c;\n      ctx.lineWidth = s.w;\n      ctx.beginPath();\n      ctx.moveTo(x1, y1);\n      ctx.lineTo(x2, y2);\n      ctx.stroke();\n      ctx.strokeStyle = 'rgba(255, 230, 190, 0.25)';\n      ctx.lineWidth = 1.5;\n      ctx.beginPath();\n      ctx.moveTo(x1 - 1.5, y1 - 2);\n      ctx.lineTo(x2 - 1.5, y2 - 2);\n      ctx.stroke();\n    });\n  }\n\n  function drawSteam() {\n    ctx.globalCompositeOperation = 'lighter';\n    for (const p of steam) {\n      const k = p.age / p.max;\n      const a = Math.sin(Math.PI * k) * 0.16;\n      if (a <= 0.001) continue;\n      const s = p.size * (0.6 + 0.9 * k);\n      ctx.globalAlpha = a;\n      ctx.drawImage(sprite, p.x - s / 2, p.y - s / 2, s, s);\n    }\n    ctx.globalAlpha = 1;\n    ctx.globalCompositeOperation = 'source-over';\n  }\n\n  function drawBackground() {\n    ctx.fillStyle = '#060403';\n    ctx.fillRect(0, 0, W, H);\n\n    // Warm ambient glow behind the bowl, breathing slowly\n    const cx = W * 0.5 + light, cy = H * 0.56;\n    const R = Math.max(W, H) * 0.7;\n    const pulse = 0.9 + 0.07 * Math.sin(time * 0.8) + 0.03 * Math.sin(time * 2.3);\n    const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, R);\n    g.addColorStop(0, `rgba(255, 150, 70, ${(0.24 * pulse).toFixed(3)})`);\n    g.addColorStop(0.35, `rgba(200, 90, 35, ${(0.10 * pulse).toFixed(3)})`);\n    g.addColorStop(1, 'rgba(60, 20, 8, 0)');\n    ctx.fillStyle = g;\n    ctx.fillRect(0, 0, W, H);\n\n    // Table falls off into darkness\n    const t = ctx.createLinearGradient(0, H * 0.72, 0, H);\n    t.addColorStop(0, 'rgba(12, 7, 4, 0)');\n    t.addColorStop(1, 'rgba(4, 2, 1, 0.9)');\n    ctx.fillStyle = t;\n    ctx.fillRect(0, H * 0.72, W, H * 0.28);\n  }\n\n  function drawMotes() {\n    for (const m of MOTES) {\n      const a = (0.12 + 0.35 * m.z) * (0.55 + 0.45 * Math.sin(time * 1.6 + m.ph));\n      ctx.fillStyle = `rgba(255, 190, 120, ${a.toFixed(3)})`;\n      ctx.beginPath();\n      ctx.arc(m.x * W, m.y * H, 0.6 + 1.3 * m.