    addRipple(pointer.wx, pointer.wy, 0.5);\n      rippleCooldown = 0.14;\n    }\n    pointer.moved = 0;\n\n    updateMotes(dt);\n    updateSteam(dt);\n  }\n\n  // ---- Render --------------------------------------------------------------\n\n  function render() {\n    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);\n    drawBackground();\n    drawMotes();\n\n    ctx.setTransform(DPR * S, 0, 0, DPR * S, DPR * OX, DPR * OY);\n    ctx.translate(view.x, view.y);\n    drawBowl();\n    drawBroth();\n    drawChopsticks();\n    drawSteam();\n  }\n\n  function frame(now) {\n    const dt = Math.min(0.05, Math.max(0, (now - last) / 1000));\n    last = now;\n    update(dt);\n    render();\n    rafId = requestAnimationFrame(frame);\n  }\n\n  // ---- Lifecycle & input ---------------------------------------------------\n\n  function resize() {\n    DPR = Math.min(window.devicePixelRatio || 1, 2);\n    W = window.innerWidth;\n    H = window.innerHeight;\n    canvas.width = Math.round(W * DPR);\n    canvas.height = Math.round(H * DPR);\n    S = clamp(Math.min(W / 620, H / 640), 0.3, 2);\n    OX = W / 2;\n    OY = H * 0.56;\n    if (motionQuery.matches) render();\n  }\n\n  function onPointer(e) {\n    const prevX = pointer.px, prevY = pointer.py;\n    pointer.px = e.clientX;\n    pointer.py = e.clientY;\n    if (pointer.active) pointer.moved += Math.hypot(pointer.px - prevX, pointer.py - prevY);\n    pointer.active = true;\n    pointer.wx = (pointer.px - OX) / S;\n    pointer.wy = (pointer.py - OY) / S;\n    view.tx = clamp((pointer.px - W * 0.5) / (W * 0.5), -1, 1) * 12;\n    view.ty = clamp((pointer.py - H * 0.56) / (H * 0.5), -1, 1) * 6;\n\n    // Reduced motion: respond to input with a single, non-animated update\n    if (motionQuery.matches) {\n      view.x = view.tx;\n      view.y = view.ty;\n      light = (pointer.px - W * 0.5) * 0.08;\n      render();\n    }\n  }\n\n  function onIdle() {\n    pointer.active = false;\n    view.tx = 0;\n    view.ty = 0;\n    if (motionQuery.matches) {