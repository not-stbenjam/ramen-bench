        "CodeContent": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Artisanal Vegan Ramen</title>\n  <style>\n    *, *::before, *::after {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    html, body {\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      background-color: #070709;\n      touch-action: none;\n      user-select: none;\n      -webkit-user-select: none;\n    }\n\n    #canvas-container {\n      position: absolute;\n      inset: 0;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    canvas {\n      display: block;\n      width: 100%;\n      height: 100%;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"canvas-container\">\n    <canvas id=\"ramenCanvas\"></canvas>\n  </div>\n\n  <script>\n    (function() {\n      const canvas = document.getElementById('ramenCanvas');\n      const ctx = canvas.getContext('2d');\n\n      let width, height, dpr;\n      let centerX, centerY, bowlRadius;\n\n      // Mouse and interactive state\n      const mouse = {\n        x: 0,\n        y: 0,\n        targetX: 0,\n        targetY: 0,\n        vx: 0,\n        vy: 0,\n        stirX: 0,\n        stirY: 0,\n        isHoveringBowl: false\n      };\n\n      // Query motion preference\n      const mediaQueryReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n      let prefersReducedMotion = mediaQueryReducedMotion.matches;\n      mediaQueryReducedMotion.addEventListener('change', (e) => {\n        prefersReducedMotion = e.matches;\n      });\n\n      function resize() {\n        dpr = Math.min(window.devicePixelRatio || 1, 2);\n        width = window.innerWidth;\n        height = window.innerHeight;\n\n        canvas.width = width * dpr;\n        canvas.height = height * dpr;\n        ctx.scale(dpr, dpr);\n\n        centerX = width / 2;\n        centerY = height / 2 + height * 0.04; // subtle lower tilt for natural perspective\n        bowlRadius = Math.min(width * 0.38, height * 0.38, 250);\n\n        if (mouse.x === 0 && mouse.y === 0) {\n          mouse.x = centerX;\n          mouse.y = centerY;\n          mouse.targetX = centerX;\n          mouse.targetY = centerY;\n        }\n\n        initParticles();\n      }\n\n      // Steam Particle System\n      const STEAM_COUNT = 140;\n      const steamParticles = [];\n\n      class SteamParticle {\n        constructor(initial = false) {\n          this.reset(initial);\n        }\n\n        reset(initial = false) {\n          // Emit from within broth area with Gaussian-like clustering\n          const angle = Math.random() * Math.PI * 2;\n          const dist = Math.sqrt(Math.random()) * (bowlRadius * 0.72);\n          this.x = centerX + Math.cos(angle) * dist;\n          this.baseX = this.x;\n          this.y = centerY + (Math.sin(angle) * dist * 0.85) + (initial ? (Math.random() * -bowlRadius * 1.6) : (Math.random() * 8 - 4));\n          \n          this.life = initial ? Math.random() : 0;\n          this.maxLife = 2.4 + Math.random() * 2.2;\n          this.speedY = 0.55 + Math.random() * 0.75;\n          this.size = 12 + Math.random() * 18;\n          this.maxSize = 55 + Math.random() * 45;\n          this.wobbleSpeed = 1.0 + Math.random() * 1.5;\n          this.wobbleAmp = 12 + Math.random() * 22;\n          this.opacity = 0.045 + Math.random() * 0.055;\n          this.phase = Math.random() * Math.PI * 2;\n          this.vx = 0;\n        }\n\n        update(dt, time) {\n          this.life += dt / this.maxLife;\n          if (this.life >= 1) {\n            this.reset(false);\n            return;\n          }\n\n          // Gentle ambient curling drift\n          const curl = Math.sin(time * this.wobbleSpeed + this.phase + this.y * 0.015) * this.wobbleAmp * dt;\n          \n          // Interaction: air displaced by mouse motion\n          const dx = this.x - mouse.x;\n          const dy = this.y - mouse.y;\n          const distSq = dx * dx + dy * dy;\n          const interactRadius = 130;\n\n          if (distSq < interactRadius * interactRadius && distSq > 1) {\n            const d = Math.sqrt(distSq);\n            const force = (1 - d / interactRadius) * 45 * dt;\n            this.vx += (dx / d) * force + mouse.vx * 0.2 * dt;\n          }\n\n          this.vx *= 0.94; // friction\n          this.x += curl + this.vx;\n          this.y -= this.speedY * (1 - this.life * 0.3) * 60 * dt;\n        }\n\n        draw(ctx) {\n          // Fade in then long atmospheric dissipation\n          let alpha;\n          if (this.life < 0.2) {\n            alpha = (this.life / 0.2) * this.opacity;\n          } else {\n            alpha = (1 - (this.life - 0.2) / 0.8) * this.opacity;\n          }\n          if (alpha <= 0.001) return;\n\n          const currentSize = this.size + (this.maxSize - this.size) * Math.pow(this.life, 0.7);\n\n          const grad = ctx.createRadialGradient(\n            this.x, this.y, 0,\n            this.x, this.y, currentSize\n          );\n          grad.addColorStop(0, `rgba(255, 236, 210, ${alpha * 1.2})`);\n          grad.addColorStop(0.35, `rgba(240, 225, 205, ${alpha * 0.7})`);\n          grad.addColorStop(0.7, `rgba(215, 200, 190, ${alpha * 0.25})`);\n          grad.addColorStop(1, 'rgba(180, 170, 160, 0)');\n\n          ctx.fillStyle = grad;\n          ctx.beginPath();\n          ctx.arc(this.x, this.y, currentSize, 0, Math.PI * 2);\n          ctx.fill();\n        }\n      }\n\n      // Golden Oil Droplets on Broth Surface\n      const OIL_COUNT = 36;\n      const oilDroplets = [];\n\n      class OilDroplet {\n        constructor() {\n          const angle = Math.random() * Math.PI * 2;\n          const distNorm = Math.sqrt(Math.random());\n          this.relDist = distNorm * 0.74;\n          this.angle = angle;\n          this.radius = 2.0 + Math.random() * 4.5;\n          this.orbitSpeed = (Math.random() - 0.5) * 0.06;\n          this.pulseOffset = Math.random() * Math.PI * 2;\n          this.colorR = 255;\n          this.colorG = 185 + Math.floor(Math.random() * 45);\n          this.colorB = 40 + Math.floor(Math.random() * 50);\n          this.opacity = 0.5 + Math.random() * 0.35;\n          this.dispX = 0;\n          this.dispY = 0;\n        }\n\n        update(dt, time, tiltX, tiltY) {\n          this.angle += this.orbitSpeed * dt;\n          \n          // Slight fluid dispersion towards mouse swirl\n          const currentX = centerX + Math.cos(this.angle) * bowlRadius * this.relDist;\n          const currentY = centerY + Math.sin(this.angle) * bowlRadius * 0.88 * this.relDist;\n          \n          const dx = currentX - mouse.x;\n          const dy = currentY - mouse.y;\n          const distSq = dx * dx + dy * dy;\n          if (distSq < 100 * 100 && distSq > 4) {\n            const d = Math.sqrt(distSq);\n            const push = (1 - d / 100) * 15;\n            this.dispX += (dx / d) * push * dt * 2.5;\n            this.dispY += (dy / d) * push * dt * 2.5;\n          }\n          this.dispX *= 0.92;\n          this.dispY *= 0.92;\n        }\n\n        draw(ctx, time, tiltX, tiltY) {\n          const x = centerX + Math.cos(this.angle) * (bowlRadius * 0.82 * this.relDist) + this.dispX + tiltX * 10;\n          const y = centerY + Math.sin(this.angle) * (bowlRadius * 0.73 * this.relDist) + this.dispY + tiltY * 10;\n          \n          const shimmer = Math.sin(time * 2.5 + this.pulseOffset) * 0.15;\n          const currentAlpha = Math.max(0, Math.min(1, this.opacity + shimmer));\n\n          ctx.save();\n          ctx.beginPath();\n          ctx.ellipse(x, y, this.radius * 1.1, this.radius * 0.85, this.angle, 0, Math.PI * 2);\n          \n          const grad = ctx.createRadialGradient(x - this.radius * 0.3, y - this.radius * 0.3, 0.5, x, y, this.radius * 1.1);\n          grad.addColorStop(0, `rgba(255, 255, 220, ${currentAlpha})`);\n          grad.addColorStop(0.4, `rgba(${this.colorR}, ${this.colorG}, ${this.colorB}, ${currentAlpha * 0.85})`);\n          grad.addColorStop(0.9, `rgba(${this.colorR * 0.7}, ${this.colorG * 0.5}, 10, ${currentAlpha * 0.4})`);\n          grad.addColorStop(1, 'rgba(80, 40, 10, 0)');\n          \n          ctx.fillStyle = grad;\n          ctx.fill();\n          ctx.restore();\n        }\n      }\n\n      function initParticles() {\n        steamParticles.length = 0;\n        for (let i = 0; i < STEAM_COUNT; i++) {\n          steamParticles.push(new SteamParticle(true));\n        }\n\n        if (oilDroplets.length === 0) {\n          for (let i = 0; i < OIL_COUNT; i++) {\n            oilDroplets.push(new OilDroplet());\n          }\n        }\n      }\n\n      // Event Listeners for smooth tracking\n      function onPointerMove(e) {\n        mouse.targetX = e.clientX;\n        mouse.targetY = e.clientY;\n      }\n\n      window.addEventListener('pointermove', onPointerMove, { passive: true });\n      window.addEventListener('touchmove', (e) => {\n        if (e.touches.length > 0) {\n          mouse.targetX = e.touches[0].clientX;\n          mouse.targetY = e.touches[0].clientY;\n        }\n      }, { passive: true });\n\n      window.addEventListener('resize', resize);\n\n      // Rendering Components\n      function drawAmbientBackground(tiltX, tiltY, time) {\n        // Deep counter/table wood aesthetic with warm hearth illumination\n        const bgGrad = ctx.createRadialGradient(\n          centerX + tiltX * 40,\n          centerY - bowlRadius * 0.4 + tiltY * 30,\n          bowlRadius * 0.2,\n          centerX,\n          centerY,\n          Math.max(width, height) * 0.85\n        );\n        bgGrad.addColorStop(0, '#1c130d');\n        bgGrad.addColorStop(0.28, '#130d0a');\n        bgGrad.addColorStop(0.65, '#090809');\n        bgGrad.addColorStop(1, '#040405');\n\n        ctx.fillStyle = bgGrad;\n        ctx.fillRect(0, 0, width, height);\n\n        // Soft rustic tabletop texture & subtle specular sheen\n        ctx.save();\n        ctx.globalCompositeOperation = 'soft-light';\n        const sheen = ctx.createLinearGradient(0, centerY - bowlRadius * 1.5, 0, height);\n        sheen.addColorStop(0, 'rgba(215, 145, 90, 0.05)');\n        sheen.addColorStop(0.5, 'rgba(255, 180, 110, 0.08)');\n        sheen.addColorStop(1, 'rgba(0, 0, 0, 0.4)');\n        ctx.fillStyle = sheen;\n        ctx.fillRect(0, 0, width, height);\n        ctx.restore();\n\n        // Atmospheric cast shadow under bowl\n        ctx.save();\n        ctx.beginPath();\n        ctx.ellipse(\n          centerX + tiltX * 25,\n          centerY + bowlRadius * 0.96 + tiltY * 15,\n          bowlRadius * 1.18,\n          bowlRadius * 0.42,\n          0, 0, Math.PI * 2\n        );\n        const shadowGrad = ctx.createRadialGradient(\n          centerX + tiltX * 25,\n          centerY + bowlRadius * 0.96 + tiltY * 15,\n          bowlRadius * 0.2,\n          centerX + tiltX * 25,\n          centerY + bowlRadius * 0.96 + tiltY * 15,\n          bowlRadius * 1.25\n        );\n        shadowGrad.addColorStop(0, 'rgba(2, 2, 3, 0.95)');\n        shadowGrad.addColorStop(0.5, 'rgba(2, 2, 3, 0.7)');\n        shadowGrad.addColorStop(0.85, 'rgba(5, 4, 4, 0.3)');\n        shadowGrad.addColorStop(1, 'transparent');\n        ctx.fillStyle = shadowGrad;\n        ctx.fill();\n        ctx.restore();\n      }\n\n      function drawCeramicBowl(tiltX, tiltY) {\n        ctx.save();\n        const r = bowlRadius;\n        const bX = centerX + tiltX * 6;\n        const bY = centerY + tiltY * 6;\n\n        // Outer Bowl Body\n        ctx.beginPath();\n        ctx.ellipse(bX, bY, r, r * 0.92, 0, 0, Math.PI * 2);\n        \n        // Ceramic stoneware gradient (matte textured black with earthy charcoal & iron glaze rim)\n        const outerGrad = ctx.createRadialGradient(\n          bX - r * 0.35, bY - r * 0.35, r * 0.1,\n          bX, bY, r * 1.05\n        );\n        outerGrad.addColorStop(0, '#323030');\n        outerGrad.addColorStop(0.4, '#1e1c1b');\n        outerGrad.addColorStop(0.75, '#141212');\n        outerGrad.addColorStop(0.96, '#282522'); // textured stoneware lip\n        outerGrad.addColorStop(1, '#0e0d0d');\n\n        ctx.fillStyle = outerGrad;\n        ctx.fill();\n\n        // Subtle ceramic rim ring with artisan flecks\n        ctx.lineWidth = Math.max(3, r * 0.032);\n        const rimGrad = ctx.createLinearGradient(bX - r, bY - r, bX + r, bY + r);\n        rimGrad.addColorStop(0, 'rgba(120, 105, 95, 0.75)');\n        rimGrad.addColorStop(0.3, 'rgba(195, 170, 140, 0.85)');\n        rimGrad.addColorStop(0.7, 'rgba(70, 60, 55, 0.6)');\n        rimGrad.addColorStop(1, 'rgba(145, 120, 100, 0.8)');\n        ctx.strokeStyle = rimGrad;\n        ctx.stroke();\n\n        // Inner Bowl Shadow Depth\n        ctx.beginPath();\n        const innerR = r * 0.94;\n        ctx.ellipse(bX, bY, innerR, innerR * 0.91, 0, 0, Math.PI * 2);\n        const innerShadow = ctx.createRadialGradient(bX, bY, innerR * 0.7, bX, bY, innerR);\n        innerShadow.addColorStop(0, 'rgba(0, 0, 0, 0)');\n        innerShadow.addColorStop(0.75, 'rgba(10, 8, 7, 0.45)');\n        innerShadow.addColorStop(1, 'rgba(5, 3, 2, 0.9)');\n        ctx.fillStyle = innerShadow;\n        ctx.fill();\n\n        ctx.restore();\n      }\n\n      function drawBroth(tiltX, tiltY, time) {\n        ctx.save();\n        const r = bowlRadius * 0.92;\n        const bX = centerX + tiltX * 8;\n        const bY = centerY + tiltY * 8;\n\n        // Broth boundary clip\n        ctx.beginPath();\n        ctx.ellipse(bX, bY, r, r * 0.9, 0, 0, Math.PI * 2);\n        ctx.clip();\n\n        // Rich Tonkotsu-style Creamy Vegan Broth (Oat, Miso, Sesame & Roasted Garlic)\n        const brothGrad = ctx.createRadialGradient(\n          bX - r * 0.25, bY - r * 0.2, r * 0.1,\n          bX, bY, r * 1.05\n        );\n        brothGrad.addColorStop(0, '#caa268'); // Warm golden creamy center\n        brothGrad.addColorStop(0.35, '#a47843'); // Rich roasted miso body\n        brothGrad.addColorStop(0.7, '#794f26'); // Deep savory stock\n        brothGrad.addColorStop(0.95, '#4e3016'); // Dark umami edge\n        brothGrad.addColorStop(1, '#2f1a0b');\n\n        ctx.fillStyle = brothGrad;\n        ctx.fill();\n\n        // Subtle shimmering wave ripples across hot broth surface\n        const rippleCount = 3;\n        for (let i = 0; i < rippleCount; i++) {\n          const wavePhase = time * 1.6 + i * 2.1;\n          const waveR = r * (0.35 + 0.22 * i + Math.sin(wavePhase) * 0.04);\n          ctx.beginPath();\n          ctx.ellipse(bX, bY, waveR, waveR * 0.88, 0, 0, Math.PI * 2);\n          ctx.strokeStyle = `rgba(255, 235, 190, ${0.06 + Math.sin(wavePhase) * 0.03})`;\n          ctx.lineWidth = 4 + i * 3;\n          ctx.stroke();\n        }\n\n        // Ray chili oil swirls (La-Yu)\n        ctx.beginPath();\n        for (let a = 0; a < Math.PI * 2; a += 0.45) {\n          const swirlR = (0.35 + 0.5 * Math.sin(a * 3 + time * 0.4)) * r * 0.85;\n          const sx = bX + Math.cos(a) * swirlR;\n          const sy = bY + Math.sin(a) * swirlR * 0.9;\n          const spotR = 12 + Math.sin(a * 4) * 6;\n          \n          const oilGrad = ctx.createRadialGradient(sx, sy, 0, sx, sy, spotR);\n          oilGrad.addColorStop(0, 'rgba(215, 60, 20, 0.45)');\n          oilGrad.addColorStop(0.6, 'rgba(180, 40, 10, 0.22)');\n          oilGrad.addColorStop(1, 'rgba(140, 30, 5, 0)');\n          \n          ctx.fillStyle = oilGrad;\n          ctx.beginPath();\n          ctx.arc(sx, sy, spotR, 0, Math.PI * 2);\n          ctx.fill();\n        }\n\n        ctx.restore();\n      }\n\n      function drawNoodles(tiltX, tiltY, time) {\n        ctx.save();\n        const r = bowlRadius * 0.92;\n        const bX = centerX + tiltX * 10;\n        const bY = centerY + tiltY * 10;\n\n        ctx.beginPath();\n        ctx.ellipse(bX, bY, r, r * 0.9, 0, 0, Math.PI * 2);\n        ctx.clip();\n\n        // Tangled wavy ramen noodle nest resting under & breaking surface of broth\n        const strands = 28;\n        ctx.lineCap = 'round';\n\n        for (let i = 0; i < strands; i++) {\n          const seed = i * 137.5;\n          const startAngle = (seed % 360) * (Math.PI / 180);\n          const noodleDist = (0.2 + (i / strands) * 0.55) * r;\n          \n          const sx = bX + Math.cos(startAngle) * noodleDist * 0.9;\n          const sy = bY + Math.sin(startAngle) * noodleDist * 0.8;\n\n          ctx.beginPath();\n          ctx.moveTo(sx, sy);\n\n          const segments = 4;\n          let curX = sx;\n          let curY = sy;\n\n          for (let s = 1; s <= segments; s++) {\n            const wave = Math.sin(time * 0.7 + i + s * 1.5) * 2.2;\n            const targetX = curX + Math.cos(startAngle + s * 0.8) * (r * 0.16) + wave;\n            const targetY = curY + Math.sin(startAngle + s * 0.8) * (r * 0.14) + wave;\n            const cpX = (curX + targetX) / 2 + Math.sin(s * 2 + i) * 12;\n            const cpY = (curY + targetY) / 2 + Math.cos(s * 2 + i) * 10;\n            \n            ctx.quadraticCurveTo(cpX, cpY, targetX, targetY);\n            curX = targetX;\n            curY = targetY;\n          }\n\n          // Shading depth: lower strands darker submerged, top strands glossy yellow wheat\n          const isDeep = i % 3 === 0;\n          ctx.lineWidth = isDeep ? 4.8 : 3.8;\n          ctx.strokeStyle = isDeep ? 'rgba(185, 142, 82, 0.45)' : 'rgba(244, 212, 145, 0.78)';\n          ctx.stroke();\n\n          // Delicate specular ridge highlight on upper noodles\n          if (!isDeep && i % 2 === 0) {\n            ctx.lineWidth = 1.2;\n            ctx.strokeStyle = 'rgba(255, 248, 220, 0.6)';\n            ctx.stroke();\n          }\n        }\n\n        ctx.restore();\n      }\n\n      function drawToppings(tiltX, tiltY, time) {\n        ctx.save();\n        const r = bowlRadius;\n        const bX = centerX + tiltX * 12;\n        const bY = centerY + tiltY * 12;\n\n        // Clip to bowl interior\n        ctx.beginPath();\n        ctx.ellipse(bX, bY, r * 0.92, r * 0.82, 0, 0, Math.PI * 2);\n        ctx.clip();\n\n        // 1. Nori Sheets (Seaweed crisps standing at top left rim)\n        ctx.save();\n        const noriAngle = -0.75;\n        const nx = bX - r * 0.42;\n        const ny = bY - r * 0.46;\n        ctx.translate(nx, ny);\n        ctx.rotate(noriAngle);\n        \n        // Back nori\n        ctx.fillStyle = '#111812';\n        ctx.beginPath();\n        ctx.roundRect(-25, -55, 48, 70, [4, 4, 2, 2]);\n        ctx.fill();\n        // Front nori overlap\n        ctx.rotate(0.2);\n        ctx.fillStyle = '#162018';\n        ctx.beginPath();\n        ctx.roundRect(-20, -50, 48, 70, [4, 4, 2, 2]);\n        ctx.fill();\n        // Nori texture flecks\n        ctx.fillStyle = 'rgba(40, 60, 45, 0.35)';\n        for (let nf = 0; nf < 12; nf++) {\n          ctx.fillRect(-15 + (nf * 3.7) % 36, -42 + (nf * 7.5) % 55, 3.5, 4.5);\n        }\n        ctx.restore();\n\n        // 2. Pan-Seared Glazed Soy-Braised Tofu Chashu (Slices at lower right)\n        for (let t = 0; t < 2; t++) {\n          ctx.save();\n          const tx = bX + r * (0.22 + t * 0.18);\n          const ty = bY + r * (0.16 - t * 0.12);\n          ctx.translate(tx, ty);\n          ctx.rotate(0.35 + t * 0.2);\n\n          // Cast shadow under tofu\n          ctx.beginPath();\n          ctx.roundRect(-30, -22, 60, 44, 8);\n          ctx.fillStyle = 'rgba(35, 18, 8, 0.45)';\n          ctx.fill();\n\n          // Golden-caramelized braised tofu body\n          const tofuGrad = ctx.createLinearGradient(-30, -20, 30, 20);\n          tofuGrad.addColorStop(0, '#7c3f15'); // soy glaze char\n          tofuGrad.addColorStop(0.35, '#d48a3e'); // golden pan-sear\n          tofuGrad.addColorStop(0.7, '#e8b26f'); // tender bean curd\n          tofuGrad.addColorStop(1, '#61300f');\n\n          ctx.fillStyle = tofuGrad;\n          ctx.beginPath();\n          ctx.roundRect(-28, -20, 56, 40, 8);\n          ctx.fill();\n\n          // Caramelized grill marks\n          ctx.strokeStyle = 'rgba(50, 20, 5, 0.65)';\n          ctx.lineWidth = 2.5;\n          ctx.beginPath();\n          ctx.moveTo(-18, -12); ctx.lineTo(-8, 12);\n          ctx.moveTo(-4, -14); ctx.lineTo(6, 10);\n          ctx.moveTo(10, -12); ctx.lineTo(20, 12);\n          ctx.stroke();\n\n          // Glossy sweet mirin-soy lacquer reflection\n          ctx.strokeStyle = 'rgba(255, 230, 180, 0.45)';\n          ctx.lineWidth = 1.5;\n          ctx.beginPath();\n          ctx.moveTo(-22, -14);\n          ctx.lineTo(22, -14);\n          ctx.stroke();\n\n          ctx.restore();\n        }\n\n        // 3. Glazed Shiitake Mushrooms (Center-left)\n        const shiitakeSpots = [\n          { x: bX - r * 0.22, y: bY + r * 0.08, size: r * 0.14, angle: 0.1 },\n          { x: bX - r * 0.36, y: bY - r * 0.04, size: r * 0.12, angle: -0.3 }\n        ];\n        shiitakeSpots.forEach((sh) => {\n          ctx.save();\n          ctx.translate(sh.x, sh.y);\n          ctx.rotate(sh.angle);\n\n          // Mushroom cap\n          const shGrad = ctx.createRadialGradient(-sh.size * 0.2, -sh.size * 0.2, 2, 0, 0, sh.size);\n          shGrad.addColorStop(0, '#532e18');\n          shGrad.addColorStop(0.65, '#2f180c');\n          shGrad.addColorStop(1, '#1a0b05');\n\n          ctx.fillStyle = shGrad;\n          ctx.beginPath();\n          ctx.ellipse(0, 0, sh.size, sh.size * 0.85, 0, 0, Math.PI * 2);\n          ctx.fill();\n\n          // Traditional decorative floral star score mark (Hana-shiitake cut)\n          ctx.strokeStyle = '#e6caa6';\n          ctx.lineWidth = 2.0;\n          ctx.lineCap = 'round';\n          for (let star = 0; star < 3; star++) {\n            ctx.save();\n            ctx.rotate(star * Math.PI / 3);\n            ctx.beginPath();\n            ctx.moveTo(-sh.size * 0.45, 0);\n            ctx.lineTo(sh.size * 0.45, 0);\n            ctx.stroke();\n            ctx.restore();\n          }\n\n          /