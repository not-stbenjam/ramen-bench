";\n      m.style.setProperty(\"--dx\", (Math.random() * 120 - 60) + \"px\");\n      m.style.setProperty(\"--dy\", -(80 + Math.random() * 220) + \"px\");\n      m.style.animationDuration = (7 + Math.random() * 10) + \"s\";\n      m.style.animationDelay = (-Math.random() * 15) + \"s\";\n      motesLayer.appendChild(m);\n    }\n  }\n  spawnMotes();\n\n  /* ---------- Mouse-reactive parallax tilt ---------- */\n  var targetRX = 0, targetRY = 0, targetGX = 0, targetGY = 0;\n  var curRX = 0, curRY = 0, curGX = 0, curGY = 0;\n\n  function onMove(e) {\n    var nx = (e.clientX / window.innerWidth) * 2 - 1;   // -1 .. 1\n    var ny = (e.clientY / window.innerHeight) * 2 - 1;\n    targetRY = nx * 7;    // rotate around Y (left/right)\n    targetRX = -ny * 5;   // rotate around X (up/down)\n    targetGX = nx * 26;   // glow shifts with cursor\n    targetGY = -ny * 16;\n  }\n\n  function onLeave() {\n    targetRX = targetRY = targetGX = targetGY = 0;\n  }\n\n  if (!reduceMotion) {\n    window.addEventListener(\"mousemove\", onMove, { passive: true });\n    window.addEventListener(\"mouseout\", onLeave);\n    // touch: gentle response to touch position too\n    window.addEventListener(\"touchmove\", function (e) {\n      if (e.touches.length) onMove(e.touches[0]);\n    }, { passive: true });\n    window.addEventListener(\"touchend\", onLeave);\n  }\n\n  function frame() {\n    curRX += (targetRX - curRX) * 0.06;\n    curRY += (targetRY - curRY) * 0.06;\n    curGX += (targetGX - curGX) * 0.05;\n    curGY += (targetGY - curGY) * 0.05;\n\n    tilt.style.transform =\n      \"perspective(900px) rotateX(\" + curRX.toFixed(3) + \"deg) rotateY(\" + curRY.toFixed(3) + \"deg)\";\n    glow.style.marginLeft = curGX.toFixed(2) + \"px\";\n    glow.style.marginBottom = curGY.toFixed(2) + \"px\";\n\n    requestAnimationFrame(frame);\n  }\n\n  if (!reduceMotion) {\n    requestAnimationFrame(frame);\n  } else {\n    // static, calm composition: show a gentle fixed steam posture via CSS override (handled in media query)\n    tilt.style.transform = \"none\";\n  }\n\n  /* ---------- Subtle warmth pulse tied to pointer proximity ---------- */\n  if (!reduceMotion) {\n    window.addEventListener(\"mousemove\", function (e) {\n      var r = stage.getBoundingClientRect();\n      var dx = e.clientX - (r.left + r.width / 2);\n      var dy = e.clientY - (r.top + r.height * 0.72);\n      var d = Math.sqrt(dx * dx + dy * dy);\n      var prox = Math.max(0, 1 - d / (r.width * 0.55)); // 0..1 near bowl\n      glow.style.opacity = (0.85 + prox * 0.15).toFixed(3);\n    }, { passive: true });\n  }\n})();\n</script>\n</body>\n</html>\n"
