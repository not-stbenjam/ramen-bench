        "path": "/app/index.html",
        "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n<title>Steaming Bowl</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  html, body {\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n    background: #0a0705;\n  }\n\n  /* ---------- Scene stage ---------- */\n  #stage {\n    position: fixed;\n    inset: 0;\n    display: flex;\n    align-items: flex-end;\n    justify-content: center;\n    /* warm hearth-like vignette */\n    background:\n      radial-gradient(120% 90% at 50% 108%, #3a1f10 0%, #241309 34%, #140b06 62%, #0a0705 100%);\n  }\n\n  /* soft warm light pool rising from the bowl */\n  #glow {\n    position: absolute;\n    left: 50%;\n    bottom: 4vh;\n    width: min(90vmin, 720px);\n    height: min(70vmin, 560px);\n    transform: translateX(-50%);\n    background: radial-gradient(50% 55% at 50% 62%, rgba(255,166,77,0.20) 0%, rgba(255,120,40,0.08) 45%, rgba(255,120,40,0) 72%);\n    filter: blur(6px);\n    pointer-events: none;\n    animation: breathe 7s ease-in-out infinite;\n  }\n\n  /* ---------- Bowl composition ---------- */\n  #bowl-wrap {\n    position: relative;\n    width: min(78vmin, 560px);\n    margin-bottom: 6vh;\n    transform-origin: 50% 100%;\n    will-change: transform;\n  }\n\n  #bowl-svg {\n    display: block;\n    width: 100%;\n    height: auto;\n    overflow: visible;\n  }\n\n  /* gentle idle bob of the whole bowl */\n  #bowl-wrap .bob {\n    animation: bob 6.5s ease-in-out infinite;\n    transform-origin: 50% 100%;\n  }\n\n  /* ---------- Steam ---------- */\n  .steam {\n    fill: none;\n    stroke-linecap: round;\n    stroke: rgba(255, 235, 215, 0.0);\n    filter: blur(2.5px);\n    transform-box: fill-box;\n    transform-origin: 50% 100%;\n    animation: steamRise 9s linear infinite;\n    opacity: 0;\n  }\n  .steam.s1 { stroke-width: 9;  animation-duration: 8.5s; animation-delay: 0s;    stroke: rgba(255,238,220,0.34); }\n  .steam.s2 { stroke-width: 6.5;animation-duration: 11s;  animation-delay: -3.2s; stroke: rgba(255,228,200,0.26); }\n  .steam.s3 { stroke-width: 8;  animation-duration: 9.5s; animation-delay: -6.1s; stroke: rgba(255,240,224,0.30); }\n  .steam.s4 { stroke-width: 5;  animation-duration: 12.5s;animation-delay: -1.7s; stroke: rgba(255,222,190,0.20); }\n  .steam.s5 { stroke-width: 7;  animation-duration: 10s;  animation-delay: -8.4s; stroke: rgba(255,236,214,0.24); }\n\n  /* ---------- Broth shimmer ---------- */\n  #broth-shimmer {\n    transform-box: fill-box;\n    transform-origin: 50% 50%;\n    animation: shimmer 5.5s ease-in-out infinite;\n    mix-blend-mode: screen;\n  }\n\n  /* ---------- Toppings gentle sway ---------- */\n  .sway-a { transform-box: fill-box; transform-origin: 50% 100%; animation: swayA 7s ease-in-out infinite; }\n  .sway-b { transform-box: fill-box; transform-origin: 50% 100%; animation: swayB 8.5s ease-in-out infinite; }\n\n  /* ---------- Chopsticks idle drift ---------- */\n  #chopsticks { transform-box: fill-box; transform-origin: 80% 90%; animation: chopDrift 9s ease-in-out infinite; }\n\n  /* ---------- Keyframes ---------- */\n  @keyframes breathe {\n    0%, 100% { opacity: 0.85; transform: translateX(-50%) scale(1); }\n    50%      { opacity: 1;    transform: translateX(-50%) scale(1.06); }\n  }\n  @keyframes bob {\n    0%, 100% { transform: translateY(0) rotate(0deg); }\n    30%      { transform: translateY(-4px) rotate(-0.4deg); }\n    65%      { transform: translateY(2px) rotate(0.35deg); }\n  }\n  @keyframes steamRise {\n    0%   { transform: translateY(14px) scale(0.7) skewX(0deg);   opacity: 0; }\n    12%  { opacity: 1; }\n    35%  { transform: translateY(-30px) scale(0.95) skewX(9deg); }\n    65%  { transform: translateY(-85px) scale(1.15) skewX(-11deg); opacity: 0.75; }\n    100% { transform: translateY(-150px) scale(1.45) skewX(7deg); opacity: 0; }\n  }\n  @keyframes shimmer {\n    0%, 100% { transform: translateX(-6%) scale(1);    opacity: 0.5; }\n    50%      { transform: translateX(6%) scale(1.08);  opacity: 0.85; }\n  }\n  @keyframes swayA {\n    0%, 100% { transform: rotate(-2.4deg) translateY(0); }\n    50%      { transform: rotate(2.2deg) translateY(-2px); }\n  }\n  @keyframes swayB {\n    0%, 100% { transform: rotate(2deg) translateY(0); }\n    50%      { transform: rotate(-2.6deg) translateY(1.5px); }\n  }\n  @keyframes chopDrift {\n    0%, 100% { transform: rotate(0deg) translateY(0); }\n    50%      { transform: rotate(-1.6deg) translateY(-3px); }\n  }\n\n  /* ---------- Mouse-reactive tilt (JS-driven, smooth) ---------- */\n  #tilt {\n    transform-style: preserve-3d;\n    will-change: transform;\n  }\n\n  /* floating dust / ember motes */\n  .mote {\n    position: absolute;\n    border-radius: 50%;\n    background: radial-gradient(circle, rgba(255,190,120,0.55) 0%, rgba(255,140,60,0.18) 55%, rgba(255,140,60,0) 75%);\n    pointer-events: none;\n    animation: moteFloat linear infinite;\n  }\n  @keyframes moteFloat {\n    0%   { transform: translate(0, 0) scale(0.6); opacity: 0; }\n    15%  { opacity: 0.9; }\n    85%  { opacity: 0.5; }\n    100% { transform: translate(var(--dx), var(--dy)) scale(1.3); opacity: 0; }\n  }\n\n  /* ---------- Reduced motion ---------- */\n  @media (prefers-reduced-motion: reduce) {\n    #glow, #bowl-wrap .bob, .steam, #broth-shimmer, .sway-a, .sway-b, #chopsticks, .mote {\n      animation: none !important;\n    }\n    .steam { opacity: 0.55; transform: translateY(-40px) scale(1.05); }\n    .mote { display: none; }\n  }\n</style>\n</head>\n<body>\n\n<div id=\"stage\">\n  <div id=\"glow\"></div>\n  <div id=\"motes\"></div>\n\n  <div id=\"bowl-wrap\">\n    <div class=\"bob\">\n      <div id=\"tilt\">\n        <svg id=\"bowl-svg\" viewBox=\"0 0 600 520\" role=\"img\" aria-label=\"A steaming bowl of vegan ramen\">\n          <defs>\n            <!-- Bowl body gradient -->\n            <linearGradient id=\"bowlBody\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n              <stop offset=\"0\"   stop-color=\"#5a3a28\"/>\n              <stop offset=\"0.35\" stop-color=\"#3d2417\"/>\n              <stop offset=\"0.75\" stop-color=\"#241209\"/>\n              <stop offset=\"1\"   stop-color=\"#160a05\"/>\n            </linearGradient>\n            <linearGradient id=\"bowlRim\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n              <stop offset=\"0\" stop-color=\"#8a5a3a\"/>\n              <stop offset=\"1\" stop-color=\"#4a2c18\"/>\n            </linearGradient>\n            <!-- Broth -->\n            <radialGradient id=\"broth\" cx=\"50%\" cy=\"42%\" r=\"65%\">\n              <stop offset=\"0\"   stop-color=\"#c96a2a\"/>\n              <stop offset=\"0.45\" stop-color=\"#a34a1c\"/>\n              <stop offset=\"0.8\"  stop-color=\"#6e2c10\"/>\n              <stop offset=\"1\"   stop-color=\"#4a1c0a\"/>\n            </radialGradient>\n            <radialGradient id=\"brothGloss\" cx=\"42%\" cy=\"35%\" r=\"55%\">\n              <stop offset=\"0\" stop-color=\"rgba(255,190,110,0.55)\"/>\n              <stop offset=\"0.6\" stop-color=\"rgba(255,150,70,0.18)\"/>\n              <stop offset=\"1\" stop-color=\"rgba(255,150,70,0)\"/>\n            </radialGradient>\n            <!-- Noodle gradient -->\n            <linearGradient id=\"noodle\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0\" stop-color=\"#f2d98c\"/>\n              <stop offset=\"1\" stop-color=\"#d9b45e\"/>\n            </linearGradient>\n            <!-- Nori -->\n            <linearGradient id=\"nori\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n              <stop offset=\"0\" stop-color=\"#1d3a24\"/>\n              <stop offset=\"1\" stop-color=\"#0d1f13\"/>\n            </linearGradient>\n            <!-- Scallion -->\n            <linearGradient id=\"scallion\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n              <stop offset=\"0\" stop-color=\"#8fd06a\"/>\n              <stop offset=\"1\" stop-color=\"#4e8f3a\"/>\n            </linearGradient>\n            <!-- Shiitake -->\n            <radialGradient id=\"shiitake\" cx=\"40%\" cy=\"35%\" r=\"70%\">\n              <stop offset=\"0\" stop-color=\"#8a5a34\"/>\n              <stop offset=\"1\" stop-color=\"#4e2c16\"/>\n            </radialGradient>\n            <!-- Soft shadow blur -->\n            <filter id=\"soft\" x=\"-40%\" y=\"-40%\" width=\"180%\" height=\"180%\">\n              <feGaussianBlur stdDeviation=\"6\"/>\n            </filter>\n            <filter id=\"soft2\" x=\"-40%\" y=\"-40%\" width=\"180%\" height=\"180%\">\n              <feGaussianBlur stdDeviation=\"2.2\"/>\n            </filter>\n\n            <!-- Reusable steam wisp path -->\n            <path id=\"wisp\" d=\"M0,0 C-14,-28 12,-52 -4,-84 C-16,-110 10,-132 2,-164\" />\n          </defs>\n\n          <!-- Ground shadow -->\n          <ellipse cx=\"300\" cy=\"470\" rx=\"215\" ry=\"30\" fill=\"#000\" opacity=\"0.55\" filter=\"url(#soft)\"/>\n          <ellipse cx=\"300\" cy=\"466\" rx=\"150\" ry=\"18\" fill=\"#000\" opacity=\"0.4\" filter=\"url(#soft)\"/>\n\n          <!-- Table hint: warm plank glow under bowl -->\n          <ellipse cx=\"300\" cy=\"462\" rx=\"260\" ry=\"34\" fill=\"#7a3d16\" opacity=\"0.18\" filter=\"url(#soft)\"/>\n\n          <!-- ===== BOWL (back rim) ===== -->\n          <path d=\"M92,268 C92,238 508,238 508,268 L508,272 C508,244 92,244 92,272 Z\" fill=\"url(#bowlRim)\"/>\n\n          <!-- ===== BROTH SURFACE ===== -->\n          <ellipse cx=\"300\" cy=\"262\" rx=\"208\" ry=\"46\" fill=\"url(#broth)\"/>\n          <ellipse cx=\"300\" cy=\"262\" rx=\"208\" ry=\"46\" fill=\"url(#brothGloss)\"/>\n\n          <!-- broth shimmering light streak -->\n          <g id=\"broth-shimmer\">\n            <ellipse cx=\"300\" cy=\"258\" rx=\"120\" ry=\"20\" fill=\"rgba(255,205,130,0.35)\" filter=\"url(#soft2)\"/>\n            <ellipse cx=\"255\" cy=\"252\" rx=\"46\" ry=\"9\" fill=\"rgba(255,230,170,0.4)\" filter=\"url(#soft2)\"/>\n          </g>\n\n          <!-- ===== NOODLES (swirled) ===== -->\n          <g stroke=\"url(#noodle)\" fill=\"none\" stroke-linecap=\"round\">\n            <path d=\"M180,268 C210,246 260,240 300,244 C350,249 400,246 424,264\" stroke-width=\"11\" opacity=\"0.95\"/>\n            <path d=\"M170,276 C205,258 262,252 306,256 C356,260 402,258 428,274\" stroke-width=\"9\" opacity=\"0.9\"/>\n            <path d=\"M186,284 C220,268 268,262 310,266 C356,270 398,268 420,282\" stroke-width=\"7\" opacity=\"0.85\"/>\n            <path d=\"M205,258 C240,244 290,240 330,244 C366,248 398,250 416,260\" stroke-width=\"8\" opacity=\"0.9\"/>\n            <path d=\"M230,250 C262,240 306,238 340,242\" stroke-width=\"6\" opacity=\"0.85\"/>\n            <path d=\"M250,292 C286,282 340,280 380,288\" stroke-width=\"6\" opacity=\"0.8\"/>\n            <path d=\"M196,262 C226,250 268,246 304,250\" stroke-width=\"5\" opacity=\"0.8\"/>\n            <path d=\"M330,254 C362,250 396,254 414,264\" stroke-width=\"5\" opacity=\"0.8\"/>\n          </g>\n\n          <!-- ===== TOPPINGS ===== -->\n          <!-- Nori sheet (standing, left) -->\n          <g class=\"sway-a\">\n            <path d=\"M196,262 L188,196 Q187,186 197,185 L232,182 Q242,181 241,191 L236,258 Q235,266 226,266 L204,266 Q197,266 196,262 Z\"\n                  fill=\"url(#nori)\" stroke=\"#0a160d\" stroke-width=\"2\"/>\n            <path d=\"M200,196 L236,193\" stroke=\"#2c5a38\" stroke-width=\"1.4\" opacity=\"0.6\"/>\n            <path d=\"M199,214 L237,211\" stroke=\"#2c5a38\" stroke-width=\"1.2\" opacity=\"0.45\"/>\n            <path d=\"M198,232 L238,229\" stroke=\"#2c5a38\" stroke-width=\"1.2\" opacity=\"0.4\"/>\n            <path d=\"M203,190 L206,258\" stroke=\"#35683f\" stroke-width=\"1\" opacity=\"0.35\"/>\n          </g>\n\n          <!-- Shiitake slices (center-right) -->\n          <g class=\"sway-b\">\n            <g transform=\"translate(352,252) rotate(-8)\">\n              <ellipse cx=\"0\" cy=\"0\" rx=\"34\" ry=\"22\" fill=\"url(#shiitake)\" stroke=\"#2e1808\" stroke-width=\"2\"/>\n              <ellipse cx=\"0\" cy=\"-2\" rx=\"24\" ry=\"13\" fill=\"#a9764a\" opacity=\"0.85\"/>\n              <path d=\"M-20,-4 Q0,-14 20,-4\" stroke=\"#5c3418\" stroke-width=\"2.4\" fill=\"none\" opacity=\"0.8\"/>\n              <path d=\"M-14,4 Q0,-2 14,4\" stroke=\"#5c3418\" stroke-width=\"1.8\" fill=\"none\" opacity=\"0.6\"/>\n            </g>\n            <g transform=\"translate(398,268) rotate(14) scale(0.72)\">\n              <ellipse cx=\"0\" cy=\"0\" rx=\"34\" ry=\"22\" fill=\"url(#shiitake)\" stroke=\"#2e1808\" stroke-width=\"2.4\"/>\n              <ellipse cx=\"0\" cy=\"-2\" rx=\"24\" ry=\"13\" fill=\"#a9764a\" opacity=\"0.85\"/>\n              <path d=\"M-20,-4 Q0,-14 20,-4\" stroke=\"#5c3418\" stroke-width=\"3\" fill=\"none\" opacity=\"0.8\"/>\n            </g>\n          </g>\n\n          <!-- Soft tofu cube (front-left) -->\n          <g class=\"sway-a\">\n            <g transform=\"translate(238,272)\">\n              <path d=\"M-26,-14 L18,-20 L30,-8 L-14,-2 Z\" fill=\"#f4ead2\"/>\n              <path d=\"M-26,-14 L-14,-2 L-14,22 L-26,10 Z\" fill=\"#e2d3b2\"/>\n              <path d=\"M-14,-2 L30,-8 L30,16 L-14,22 Z\" fill=\"#efe3c6\" stroke=\"#cbb98f\" stroke-width=\"1\"/>\n              <path d=\"M-20,-8 L14,-13\" stroke=\"#fffaf0\" stroke-width=\"2\" opacity=\"0.7\"/>\n            </g>\n          </g>\n\n          <!-- Corn kernels -->\n          <g class=\"sway-b\" fill=\"#f6c945\" stroke=\"#c9932a\" stroke-width=\"1\">\n            <ellipse cx=\"300\" cy=\"278\" rx=\"8\" ry=\"6\" transform=\"rotate(-18 300 278)\"/>\n            <ellipse cx=\"318\" cy=\"284\" rx=\"8\" ry=\"6\" transform=\"rotate(22 318 284)\"/>\n            <ellipse cx=\"284\" cy=\"286\" rx=\"7\" ry=\"5.5\" transform=\"rotate(40 284 286)\"/>\n            <ellipse cx=\"332\" cy=\"276\" rx=\"7\" ry=\"5.5\" transform=\"rotate(-35 332 276)\"/>\n            <ellipse cx=\"306\" cy=\"292\" rx=\"7\" ry=\"5\" transform=\"rotate(8 306 292)\"/>\n          </g>\n          <g fill=\"#ffe28a\" opacity=\"0.8\">\n            <ellipse cx=\"298\" cy=\"276\" rx=\"3\" ry=\"2\"/>\n            <ellipse cx=\"316\" cy=\"282\" rx=\"3\" ry=\"2\"/>\n            <ellipse cx=\"330\" cy=\"274\" rx=\"2.6\" ry=\"1.8\"/>\n          </g>\n\n          <!-- Scallion rings scattered -->\n          <g class=\"sway-a\">\n            <g fill=\"none\" stroke=\"url(#scallion)\" stroke-width=\"4.5\">\n              <circle cx=\"268\" cy=\"262\" r=\"6\"/>\n              <circle cx=\"344\" cy=\"290\" r=\"5.5\"/>\n              <circle cx=\"258\" cy=\"290\" r=\"5\"/>\n              <circle cx=\"376\" cy=\"256\" r=\"5\"/>\n              <circle cx=\"222\" cy=\"278\" r=\"4.5\"/>\n              <circle cx=\"312\" cy=\"266\" r=\"4.5\"/>\n            </g>\n            <g fill=\"#b9e89a\" opacity=\"0.85\">\n              <circle cx=\"268\" cy=\"262\" r=\"2.2\"/>\n              <circle cx=\"344\" cy=\"290\" r=\"2\"/>\n              <circle cx=\"258\" cy=\"290\" r=\"1.8\"/>\n              <circle cx=\"376\" cy=\"256\" r=\"1.8\"/>\n              <circle cx=\"222\" cy=\"278\" r=\"1.6\"/>\n              <circle cx=\"312\" cy=\"266\" r=\"1.6\"/>\n            </g>\n          </g>\n\n          <!-- Baby bok choy (right) -->\n          <g class=\"sway-b\" transform=\"translate(416,278) rotate(24)\">\n            <path d=\"M0,0 C-16,-6 -22,-26 -14,-44 C-8,-56 8,-56 14,-44 C22,-26 16,-6 0,0 Z\" fill=\"#5da244\" stroke=\"#3c7030\" stroke-width=\"1.6\"/>\n            <path d=\"M0,-2 C-8,-10 -10,-28 -5,-42\" stroke=\"#8cc46e\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/>\n            <path d=\"M0,-2 C8,-10 10,-28 5,-42\" stroke=\"#7ab862\" stroke-width=\"3.4\" fill=\"none\" stroke-linecap=\"round\"/>\n            <path d=\"M0,0 C-4,-14 -3,-30 0,-44\" stroke=\"#a5d98a\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/>\n            <path d=\"M-12,-30 C-6,-34 6,-34 12,-30 C8,-22 -8,-22 -12,-30 Z\" fill=\"#cfe8b0\" opacity=\"0.9\"/>\n          </g>\n\n          <!-- Sesame seeds -->\n <g fill=\"#f3e6c8\" opacity=\"0.9\">\n            <ellipse cx=\"286\" cy=\"270\" rx=\"2.4\" ry=\"1.4\" transform=\"rotate(20 286 270)\"/>\n            <ellipse cx=\"360\" cy=\"282\" rx=\"2.4\" ry=\"1.4\" transform=\"rotate(-30 360 282)\"/>\n            <ellipse cx=\"246\" cy=\"266\" rx=\"2.2\" ry=\"1.3\" transform=\"rotate(50 246 266)\"/>\n            <ellipse cx=\"326\" cy=\"258\" rx=\"2.2\" ry=\"1.3\" transform=\"rotate(-12 326 258)\"/>\n            <ellipse cx=\"392\" cy=\"276\" rx=\"2.2\" ry=\"1.3\" transform=\"rotate(35 392 276)\"/>\n            <ellipse cx=\"270\" cy=\"296\" rx=\"2.2\" ry=\"1.3\" transform=\"rotate(-45 270 296)\"/>\n          </g>\n\n          <!-- Chili oil droplets on broth -->\n          <g fill=\"#d43a12\" opacity=\"0.75\">\n            <circle cx=\"238\" cy=\"256\" r=\"4.5\"/>\n            <circle cx=\"368\" cy=\"266\" r=\"3.6\"/>\n            <circle cx=\"300\" cy=\"240\" r=\"3\"/>\n            <circle cx=\"410\" cy=\"286\" r=\"3.2\"/>\n          </g>\n          <g fill=\"#ff7a3c\" opacity=\"0.6\">\n            <circle cx=\"237\" cy=\"255\" r=\"1.6\"/>\n            <circle cx=\"367\" cy=\"265\" r=\"1.3\"/>\n            <circle cx=\"409\" cy=\"285\" r=\"1.2\"/>\n          </g>\n\n          <!-- ===== STEAM (behind rim front, above broth) ===== -->\n          <g>\n            <use href=\"#wisp\" class=\"steam s1\" x=\"252\" y=\"238\"/>\n            <use href=\"#wisp\" class=\"steam s2\" x=\"300\" y=\"230\" transform=\"translate(0,0) scale(1)\"/>\n            <use href=\"#wisp\" class=\"steam s3\" x=\"348\" y=\"240\"/>\n            <use href=\"#wisp\" class=\"steam s4\" x=\"276\" y=\"234\"/>\n            <use href=\"#wisp\" class=\"steam s5\" x=\"326\" y=\"236\"/>\n          </g>\n\n          <!-- ===== BOWL FRONT ===== -->\n          <path d=\"M92,268\n                   C92,268 96,392 168,438\n                   C216,470 384,470 432,438\n                   C504,392 508,268\n                   C508,300 470,318 300,318\n                   C130,318 92,300 92,268 Z\"\n                fill=\"url(#bowlBody)\"/>\n\n          <!-- decorative band on bowl -->\n          <path d=\"M112,330 C180,352 420,352 488,330\" fill=\"none\" stroke=\"#c98a4e\" stroke-width=\"5\" opacity=\"0.55\"/>\n          <path d=\"M118,344 C184,364 416,364 482,344\" fill=\"none\" stroke=\"#8a5a30\" stroke-width=\"2.4\" opacity=\"0.5\"/>\n          <!-- wave pattern on band -->\n          <g fill=\"none\" stroke=\"#e0a468\" stroke-width=\"2\" opacity=\"0.4\">\n            <path d=\"M150,338 q10,-9 20,0 q10,9 20,0\"/>\n            <path d=\"M210,346 q10,-9 20,0 q10,9 20,0\"/>\n            <path d=\"M270,350 q10,-9 20,0 q10,9 20,0\"/>\n            <path d=\"M330,350 q10,-9 20,0 q10,9 20,0\"/>\n            <path d=\"M390,346 q10,-9 20,0 q10,9 20,0\"/>\n            <path d=\"M440,338 q10,-9 20,0\"/>\n          </g>\n\n          <!-- rim highlight -->\n          <path d=\"M96,266 C96,244 504,244 504,266\" fill=\"none\" stroke=\"#c98d55\" stroke-width=\"5\" opacity=\"0.85\" stroke-linecap=\"round\"/>\n          <path d=\"M104,262 C140,250 460,250 496,262\" fill=\"none\" stroke=\"#f0c084\" stroke-width=\"2\" opacity=\"0.5\" stroke-linecap=\"round\"/>\n\n          <!-- body sheen -->\n          <path d=\"M150,300 C160,350 190,400 230,428 C196,414 158,372 142,318 Z\" fill=\"rgba(255,190,120,0.10)\"/>\n          <path d=\"M452,306 C446,352 424,398 392,424 C420,404 452,360 462,314 Z\" fill=\"rgba(0,0,0,0.28)\"/>\n\n          <!-- foot of bowl -->\n          <path d=\"M236,452 C260,462 340,462 364,452 C356,470 244,470 236,452 Z\" fill=\"#1c0e07\"/>\n          <ellipse cx=\"300\" cy=\"452\" rx=\"64\" ry=\"9\" fill=\"#2a160b\"/>\n\n          <!-- ===== CHOPSTICKS resting across rim ===== -->\n          <g id=\"chopsticks\">\n            <g transform=\"rotate(-7 300 250)\">\n              <rect x=\"150\" y=\"228\" width=\"330\" height=\"7\" rx=\"3.5\" fill=\"#b98