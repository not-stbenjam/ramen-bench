{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ramen-bench-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-02",
  "vars": {
    "ALLOWED_ORIGINS": "https://not-stbenjam.github.io,http://localhost:8000,http://127.0.0.1:8000"
  },
  "secrets": {
    "required": ["VOTER_HASH_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ramen-bench-ratings",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
